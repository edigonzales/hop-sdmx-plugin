<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ch.so.agi</groupId>
    <artifactId>hop-plugin-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <artifactId>hop-sdmx-plugin-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Apache Hop SDMX Plugin</name>
  <description>Apache Hop SDMX input with dynamic discovery and a saved output schema.</description>
  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit/</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>hop-sdmx-core</module>
    <module>hop-transform-sdmx</module>
    <module>assemblies</module>
  </modules>



  <!-- The parent is still a snapshot and is resolved before inheritance, so these repositories
       are required for local builds. CI provides the same repositories through its settings. -->
  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo1.maven.org/maven2/</url>
    </repository>
    <repository>
      <id>jars-interlis</id>
      <url>https://jars.interlis.ch/</url>
    </repository>
    <repository>
      <id>sogeo-releases</id>
      <url>https://jars.interlis.guru/releases/</url>
    </repository>
    <repository>
      <id>sogeo-snapshots</id>
      <url>https://jars.interlis.guru/snapshots/</url>
    </repository>
  </repositories>


</project>
